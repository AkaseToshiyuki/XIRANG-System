{
  "name": "@xirang/web",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/normalize-dist-permissions.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:templates": "node scripts/audit-builtin-templates.mjs",
    "audit:theme": "node scripts/audit-theme.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.56.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "6.4.3"
  }
}
