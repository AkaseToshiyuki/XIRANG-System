# Copy to /etc/xirang/xirangd.env and review before enabling the service.
# Keep management and Agent listeners behind an explicitly configured firewall.
XIRANGD_ARGS=-tls-host=cluster.example.org -agent-listen=0.0.0.0:8444 -build-enabled -build-user=xirang-build -build-cgroup-root=/sys/fs/cgroup/system.slice/xirangd.service

# Active/passive external state example (remote PostgreSQL must use TLS):
# XIRANGD_ARGS=-tls-host=cluster.example.org -agent-listen=0.0.0.0:8444 -external-state-dsn=postgresql://xirang@db.example.org/xirang?sslmode=verify-full -external-state-namespace=production

# OIDC example:
# XIRANGD_ARGS=-oidc-issuer=https://identity.example.org -oidc-audience=xirang -oidc-jwks-url=https://identity.example.org/.well-known/jwks.json -oidc-group-role=xirang-viewers=viewer -oidc-group-role=xirang-operators=operator -oidc-group-role=xirang-admins=admin
