# Copy to /etc/xirang/xirang-agent.env and review before enabling the service.
# Repeat the trust-key flag while rotating Build Manager signing keys.
XIRANG_AGENT_ARGS=-artifact-trust-key-file=/etc/xirang/build-signing-current.pub
# To make this node a native build worker, append the following flags. The
# workspace must be the same administrator-managed shared path on every worker.
# -build-enabled -build-user=xirang-build -build-cgroup-root=auto -build-workspace-root=/srv/xirang/XirangShare/.xirang/builds/work -build-local-workspace-root=/var/lib/xirang-build
# Optional read-only server temperature fallbacks. Sysfs hwmon/thermal-zone is
# always preferred. Set IPMI to an absolute ipmitool path, or configure a
# Redfish Thermal endpoint with a root-only password file and optional CA.
# XIRANG_IPMI_TOOL=/usr/bin/ipmitool
# XIRANG_REDFISH_THERMAL_URL=https://bmc.example/redfish/v1/Chassis/1/Thermal
# XIRANG_REDFISH_USERNAME=xirang-monitor
# XIRANG_REDFISH_PASSWORD_FILE=/etc/xirang/redfish-password
# XIRANG_REDFISH_CA_FILE=/etc/xirang/redfish-ca.crt
